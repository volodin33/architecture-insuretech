        <mxCell id="e_inv2" edge="1" parent="1" source="64" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;dashed=1;fontSize=10;fontColor=#9673a6;fontStyle=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="redis2" value="cache invalidate">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1240" y="415" />
              <mxPoint x="1240" y="735" />
            </Array>
